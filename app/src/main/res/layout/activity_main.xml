<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="@drawable/quiz_screen_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcome_eyebrow"
        android:textColor="@color/quiz_green"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginBottom="22dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/welcome_title"
        android:textColor="@color/quiz_ink"
        android:textSize="34sp"
        android:textStyle="bold"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcome_subtitle"
        android:textColor="@color/quiz_muted"
        android:textSize="17sp"
        android:layout_marginBottom="34dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/question_count"
            android:textColor="@color/quiz_green_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:background="@drawable/quiz_surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/points_per_question"
            android:textColor="@color/quiz_green_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="10dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:background="@drawable/quiz_surface" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/checkShuffle"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:buttonTint="@color/quiz_green"
        android:text="@string/shuffle_questions"
        android:textColor="@color/quiz_ink"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/shuffle_hint"
        android:textColor="@color/quiz_muted"
        android:textSize="13sp"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/quiz_green"
        android:text="@string/start_quiz"
        android:textAllCaps="false"
        android:textColor="@color/quiz_surface"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
