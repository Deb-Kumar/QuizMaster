<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/quiz_surface">

    <TextView
        android:id="@+id/tvReviewNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/quiz_green"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvReviewPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/quiz_ink"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvReviewYourAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvReviewCorrectAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/quiz_green_dark"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvReviewExplanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/quiz_muted"
        android:textSize="14sp" />
</LinearLayout>
