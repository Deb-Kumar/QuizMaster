<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quizRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/quiz_screen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/tvQuestionNo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Question 1 / 15"
            android:textColor="@color/quiz_green"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:layout_marginBottom="12dp" />

        <ProgressBar
            android:id="@+id/quizProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="15"
            android:progress="1"
            android:progressTint="@color/quiz_green"
            android:progressBackgroundTint="@color/quiz_line"
            android:indeterminate="false"
            android:layout_marginBottom="22dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/quiz_surface">

            <TextView
                android:id="@+id/tvCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/quiz_green"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question"
                android:textColor="@color/quiz_ink"
                android:textSize="23sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="18dp" />

            <RadioGroup
                android:id="@+id/radioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/option1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:padding="10dp"
                    android:text="Option 1"
                    android:textColor="@color/quiz_ink"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/option2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:padding="10dp"
                    android:text="Option 2"
                    android:textColor="@color/quiz_ink"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/option3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:padding="10dp"
                    android:text="Option 3"
                    android:textColor="@color/quiz_ink"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/option4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:padding="10dp"
                    android:text="Option 4"
                    android:textColor="@color/quiz_ink"
                    android:textSize="16sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/tvFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/quiz_green_dark"
                android:textSize="15sp"
                android:lineSpacingExtra="2dp"
                android:paddingTop="14dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <Button
                android:id="@+id/btnPrevious"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:backgroundTint="@color/quiz_surface"
                android:text="@string/previous_question"
                android:textAllCaps="false"
                android:textColor="@color/quiz_green"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:backgroundTint="@color/quiz_green"
                android:text="@string/next_question"
                android:textAllCaps="false"
                android:textColor="@color/quiz_surface"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
