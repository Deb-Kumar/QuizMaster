<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QuizMaster" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/quiz_green</item>
        <item name="android:statusBarColor">@color/quiz_background</item>
        <item name="android:navigationBarColor">@color/quiz_background</item>
        <item name="android:windowBackground">@color/quiz_window_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Android 12+ System Splash Screen: suppress the default OS launcher icon so only custom Compose splash displays -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/transparent_splash_icon</item>
        <item name="android:windowSplashScreenBackground">@color/quiz_window_bg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
